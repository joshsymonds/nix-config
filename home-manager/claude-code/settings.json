{
  "companyAnnouncements": [],
  "viewMode": "default",
  "model": "claude-opus-5-5",
  "effortLevel": "high",
  "preferredNotifChannel": "notifications_disabled",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read(/run/strongbox/**)",
      "Grep(/run/strongbox/**)",
      "Glob(/run/strongbox/**)"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "autoUpdater": {
    "disabled": true
  },
  "cleanupPeriodDays": 36500,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_AUTOUPDATER": "1",
    "GAMBIT_VALIDATE_DISPATCH": "__GAMBIT_VALIDATE_DISPATCH__"
  },
  "statusLine": {
    "type": "command",
    "command": "steward-statusline",
    "padding": 0,
    "refreshInterval": 5
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "steward subagent-statusline"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/destructive-guard.py"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/private-store-guard.py"
          }
        ]
      },
      {
        "matcher": "Agent|Task|mcp__orrery__step_start",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/gambit-dispatch-guard.py"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "orrery hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/usage-summary-refresh.sh"
          },
          {
            "type": "command",
            "command": "orrery hook"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|agent_needs_input|elicitation_dialog|elicitation_url_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "orrery hook",
            "timeout": 90
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/gambit-record-context.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "orrery hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/aws-profile-mirror.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "orrery hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "orrery hook"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "orrery hook"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "orrery hook"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {},
  "enabledPlugins": {
    "gambit@gambit": true,
    "frontend-design@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "nixd-lsp@nixd-lsp": true
  }
}
