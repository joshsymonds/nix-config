{
  "companyAnnouncements": [],
  "viewMode": "default",
  "model": "claude-fable-5-1",
  "effortLevel": "high",
  "preferredNotifChannel": "notifications_disabled",
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "skipDangerousModePermissionPrompt": true,
  "autoUpdater": {
    "disabled": true
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "DISABLE_AUTOUPDATER": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "steward-statusline",
    "padding": 0,
    "refreshInterval": 5
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "steward subagent-statusline"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/destructive-guard.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/usage-summary-refresh.sh"
          },
          {
            "type": "command",
            "command": "steward notify --harness claude-code",
            "timeout": 90
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "steward notify --harness claude-code",
            "timeout": 90
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "steward notify --harness claude-code"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/aws-profile-mirror.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {},
  "enabledPlugins": {
    "gambit@gambit": true,
    "frontend-design@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  }
}
