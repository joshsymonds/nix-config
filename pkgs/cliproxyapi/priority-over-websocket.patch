+func TestCodexPriorityRequested(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		payload string
+		want    bool
+	}{
+		{name: "empty", payload: "", want: false},
+		{name: "no tier", payload: `{"model":"gpt-5.6-luna","input":[]}`, want: false},
+		{name: "default tier", payload: `{"model":"gpt-5.6-luna","service_tier":"default"}`, want: false},
+		{name: "priority", payload: `{"model":"gpt-5.6-luna","service_tier":"priority"}`, want: true},
+		{name: "fast alias", payload: `{"model":"gpt-5.6-luna","service_tier":"Fast"}`, want: true},
+		{name: "claude speed fast", payload: `{"model":"gpt-5.6-luna","speed":"fast","messages":[]}`, want: true},
+		{name: "claude speed standard", payload: `{"model":"gpt-5.6-luna","speed":"standard","messages":[]}`, want: false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got := codexPriorityRequested(cliproxyexecutor.Request{Model: "gpt-5.6-luna", Payload: []byte(tc.payload)})
+			if got != tc.want {
+				t.Fatalf("codexPriorityRequested() = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
