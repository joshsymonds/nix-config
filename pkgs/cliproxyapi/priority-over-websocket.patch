+// TestCodexAutoExecutorRoutesPriorityHTTPDownstreamOverWebsocket sends a Claude
+// speed: fast request from an HTTP downstream through the auto executor and
+// asserts the upstream sees a websocket upgrade, not an HTTP POST; the same
+// request without the tier stays on HTTP. Both auths enable websockets, which is
+// what the HTTP downstream previously never benefited from.
+func TestCodexAutoExecutorRoutesPriorityHTTPDownstreamOverWebsocket(t *testing.T) {
+	transports := make(chan string, 4)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if strings.EqualFold(r.Header.Get("Upgrade"), "websocket") {
+			transports <- "websocket"
+			w.WriteHeader(http.StatusUpgradeRequired)
+			_, _ = w.Write([]byte(`{"error":{"message":"websocket unavailable"}}`))
+			return
+		}
+		transports <- "http"
+		w.WriteHeader(http.StatusInternalServerError)
+		_, _ = w.Write([]byte(`{"error":{"message":"http stub"}}`))
+	}))
+	defer server.Close()
+
+	exec := NewCodexAutoExecutor(&config.Config{SDKConfig: config.SDKConfig{DisableImageGeneration: config.DisableImageGenerationAll}})
+	auth := &cliproxyauth.Auth{
+		ID:       "codex-priority-test",
+		Provider: "codex",
+		Attributes: map[string]string{
+			"api_key":    "sk-test",
+			"base_url":   server.URL,
+			"websockets": "true",
+		},
+	}
+	opts := cliproxyexecutor.Options{
+		SourceFormat:   sdktranslator.FromString("claude"),
+		ResponseFormat: sdktranslator.FromString("claude"),
+	}
+	execute := func(payload string) {
+		t.Helper()
+		_, _ = exec.ExecuteStream(context.Background(), auth, cliproxyexecutor.Request{
+			Model:   "gpt-5.6-luna",
+			Payload: []byte(payload),
+		}, opts)
+	}
+
+	// drain collects every upstream contact one request produced; the stub
+	// answers the upgrade with 426, so a websocket attempt is followed by the
+	// executor's own HTTP fallback, and both must be attributed to that request.
+	drain := func() []string {
+		var seen []string
+		for {
+			select {
+			case transport := <-transports:
+				seen = append(seen, transport)
+			case <-time.After(500 * time.Millisecond):
+				return seen
+			}
+		}
+	}
+
+	execute(`{"model":"gpt-5.6-luna","max_tokens":16,"speed":"fast","messages":[{"role":"user","content":"hi"}]}`)
+	priority := drain()
+	if len(priority) == 0 || priority[0] != "websocket" {
+		t.Fatalf("priority request transports = %v, want websocket first", priority)
+	}
+
+	execute(`{"model":"gpt-5.6-luna","max_tokens":16,"messages":[{"role":"user","content":"hi"}]}`)
+	standard := drain()
+	if len(standard) != 1 || standard[0] != "http" {
+		t.Fatalf("standard request transports = %v, want [http]", standard)
+	}
+}
