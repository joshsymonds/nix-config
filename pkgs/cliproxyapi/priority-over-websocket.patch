+// codexPriorityRequested reports whether the untranslated source payload asks
+// for the Codex priority service tier: an explicit service_tier of priority or
+// fast, or Anthropic's speed: fast, which the Claude translator maps to
+// priority. It is evaluated before translation and payload rules, on the same
+// source fields those translators read.
+func codexPriorityRequested(req cliproxyexecutor.Request) bool {
+	if len(req.Payload) == 0 {
+		return false
+	}
+	switch strings.ToLower(strings.TrimSpace(gjson.GetBytes(req.Payload, "service_tier").String())) {
+	case "priority", "fast":
+		return true
+	}
+	return strings.EqualFold(strings.TrimSpace(gjson.GetBytes(req.Payload, "speed").String()), "fast")
+}
