+			// larger of (X11 geometry, committed buffer dimensions) so we
+			// never shrink the source below either; this preserves the
+			// existing behaviour for games whose X11 geometry was already
+			// sized correctly, while recovering the buffer dimensions for
+			// games that left the X11 window as a placeholder.
+			sourceWidth  = std::max<int32_t>(scaleW->GetGeometry().nWidth,  layer->tex->width());
+			sourceHeight = std::max<int32_t>(scaleW->GetGeometry().nHeight, layer->tex->height());
 
