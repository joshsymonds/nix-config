diff --git a/src/steamcompmgr.cpp b/src/steamcompmgr.cpp
index c4cee70..64a8107 100644
--- a/src/steamcompmgr.cpp
+++ b/src/steamcompmgr.cpp
@@ -3264,7 +3264,34 @@ win_is_useless( steamcompmgr_win_t *w )
 	// Windows that are 1x1 are pretty useless for override redirects.
 	// Just ignore them.
 	// Fixes the Xbox Login in Age of Empires 2: DE.
-	return w->GetGeometry().nWidth == 1 && w->GetGeometry().nHeight == 1;
+	//
+	// Exception: a 1x1 window with an active content_override (i.e. a
+	// gamescope_swapchain.override_window_content has bound a real
+	// swapchain to it via the bypass layer) is NOT useless. RE Engine
+	// titles like PRAGMATA leave their main X11 window at a 1x1
+	// placeholder for DXGI exclusive fullscreen, while the actual
+	// swapchain renders at the game's chosen resolution and is
+	// composited via the bypass-layer path. Marking those windows
+	// useless excludes them from focusable windows entirely, so they
+	// never reach paint_window_commit and the game black-screens
+	// permanently while the GPU is fully active and presenting frames.
+	// Caught in PRAGMATA on Wine + proton-cachyos + gamescope: the only
+	// 1x1 window WAS the main game window; the AoE2 Xbox Login case the
+	// original heuristic was meant to fix has no content_override (the
+	// login overlay isn't a swapchain target), so the AoE2 fix is
+	// preserved.
+	if ( w->GetGeometry().nWidth != 1 || w->GetGeometry().nHeight != 1 )
+		return false;
+
+	if ( w->type == steamcompmgr_win_type_t::XWAYLAND
+			&& w->xwayland().ctx != nullptr
+			&& w->xwayland().ctx->xwayland_server != nullptr
+			&& w->xwayland().ctx->xwayland_server->content_overrides.count( w->id() ) )
+	{
+		return false;
+	}
+
+	return true;
 }
 
 static bool
